# Database password: generated by Terraform, never written in code or Git.
resource "random_password" "mysql" {
  length           = 24
  special          = true
  override_special = "!#%*-_=+"
  min_upper        = 2
  min_lower        = 2
  min_numeric      = 2
  min_special      = 2
}

# Azure Database for MySQL Flexible Server, cheapest Burstable tier.
# TLS is required by default (require_secure_transport = ON). Keep it that way.
resource "azurerm_mysql_flexible_server" "main" {
  name                   = "mysql-${var.project}-${local.suffix}"
  resource_group_name    = azurerm_resource_group.main.name
  location               = azurerm_resource_group.main.location
  administrator_login    = var.mysql_admin_username
  administrator_password = random_password.mysql.result
  sku_name               = "B_Standard_B1ms"
  version                = "8.0.21"

  backup_retention_days        = 7
  geo_redundant_backup_enabled = false

  storage {
    size_gb           = 20
    auto_grow_enabled = true
  }

  tags = local.tags

  lifecycle {
    # Azure picks an availability zone; ignore it so later plans stay clean.
    ignore_changes = [zone]
  }
}

resource "azurerm_mysql_flexible_database" "app" {
  name                = "shortlink"
  resource_group_name = azurerm_resource_group.main.name
  server_name         = azurerm_mysql_flexible_server.main.name
  charset             = "utf8mb4"
  collation           = "utf8mb4_unicode_ci"
}

# 0.0.0.0 - 0.0.0.0 is Azure's special rule for "allow Azure services" (includes AKS's outbound IP).
# Stretch goal: replace with private networking (VNet integration).
resource "azurerm_mysql_flexible_server_firewall_rule" "allow_azure_services" {
  name                = "AllowAzureServices"
  resource_group_name = azurerm_resource_group.main.name
  server_name         = azurerm_mysql_flexible_server.main.name
  start_ip_address    = "0.0.0.0"
  end_ip_address      = "0.0.0.0"
}
